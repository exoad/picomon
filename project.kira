// The smoke firmware: the rp2350 library's modules on a real board, built by PlatformIO.
PROJECT: Project { } with {
    name = "smoke"
    srcDir = "src"
    target = "cpp"
    cpp = Cpp {
        layout = "beside",
        runtimeDir = "lib",
        lineDirectives = false,
        sourceExt = ".kira.cpp",
        headerOnly = @listOf("rp2350.**")
    }
    types = "strict"
    dependencies = @mapOf("kira_stdlib", "vendor/kira/kira", "rp2350", "rp2350", "rp2350.fw", "rp2350fw")
}
