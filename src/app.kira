// The smoke firmware: blinks the LED of the board named by PICOMON_BOARD twice a second, echoes what arrives on the
// USB serial port, and feeds a watchdog armed at boot. A board with no profile, or whose LED the library cannot drive,
// is refused: the program never drives an LED it does not have.

rp2350.board.Board as Board
rp2350.board.boardAt as boardAt
rp2350.board.ledRoute as ledRoute
rp2350.board.LED_NONE as LED_NONE
rp2350.board.LED_WIRELESS as LED_WIRELESS
rp2350.timing.Ticker as Ticker
rp2350.fw.board.BOARD_INDEX as BOARD_INDEX
rp2350.fw.clock as clock
rp2350.fw.gpio as gpio
rp2350.fw.usb as usb
rp2350.fw.watchdog as watchdog
rp2350.fw.uart as uart
rp2350.fw.i2c as i2c
rp2350.fw.pwm as pwm
rp2350.fw.adc as adc
rp2350.fw.eeprom as eeprom
rp2350.fw.edges as edges
rp2350.fw.chip as chip
rp2350.fw.servo.Servo as Servo

HALF_PERIOD_US: Int64 = 500000
WATCHDOG_MS: Int32 = 2000

refused: Mutable<Bool> = false
ledPin: Mutable<Int32> = -1
lit: Mutable<Bool> = false
ticker: Mutable<Ticker> { HALF_PERIOD_US }
// Built but never attached: it drives no pin until a program picks one.
idleServo: Mutable<Servo> { }

pub setup: () Void {
    usb.begin(115200)
    board: Board = boardAt(BOARD_INDEX)
    route: Int32 = ledRoute(board)
    refused = route == LED_NONE
    if !refused {
        // On a Pico 2 W, arduino-pico routes its LED pin through the wireless chip.
        ledPin = route == LED_WIRELESS ? gpio.LED_PIN as Int32 : board.ledPin
        gpio.mode(ledPin, gpio.MODE_OUTPUT)
    }
    watchdog.arm(WATCHDOG_MS)
}

pub loop: () Void {
    watchdog.feed()
    got: Maybe<UInt8> = usb.read()
    if !got.isNull() {
        usb.write(got.unwrapOr(0))
    }
    if !refused && ticker.due(clock.micros()) {
        lit = !lit
        gpio.write(ledPin, lit)
    }
    clock.sleepMs(1)
}
