// The smoke firmware: blinks the LED of the board named by PICOMON_BOARD twice a second. A board with no profile,
// or whose LED the library cannot drive, is refused: the program never drives an LED it does not have.

rp2350.board.Board as Board
rp2350.board.boardAt as boardAt
rp2350.board.ledRoute as ledRoute
rp2350.board.LED_NONE as LED_NONE
rp2350.board.LED_WIRELESS as LED_WIRELESS
rp2350.timing.Ticker as Ticker
rp2350.fw.board.BOARD_INDEX as BOARD_INDEX
rp2350.fw.clock as clock
rp2350.fw.gpio as gpio
rp2350.fw.cyw43 as cyw43
rp2350.fw.uart as uart
rp2350.fw.i2c as i2c
rp2350.fw.pwm as pwm
rp2350.fw.adc as adc

HALF_PERIOD_US: Int64 = 500000

refused: Mutable<Bool> = false
wireless: Mutable<Bool> = false
ledPin: Mutable<Int32> = -1
lit: Mutable<Bool> = false
ticker: Mutable<Ticker> { HALF_PERIOD_US }

pub setup: () Void {
    board: Board = boardAt(BOARD_INDEX)
    route: Int32 = ledRoute(board)
    refused = route == LED_NONE
    wireless = route == LED_WIRELESS
    if wireless {
        cyw43.init()
    } else if !refused {
        ledPin = board.ledPin
        gpio.init(ledPin)
        gpio.setOutput(ledPin)
    }
}

pub loop: () Void {
    if refused {
        clock.sleepMs(100)
    } else {
        if ticker.due(clock.micros()) {
            lit = !lit
            if wireless {
                cyw43.writeLed(lit)
            } else {
                gpio.write(ledPin, lit)
            }
        }
        clock.sleepMs(1)
    }
}
