// An I2C bus as controller: bus0 is i2c0 (Wire), bus1 is i2c1 (Wire1). Its pins are GPIO numbers, set before begin.

@_opaque @_extern(cpp = "TwoWire", header = "Wire.h") RawWire: Mutable<Any> {
    pub @_mutates @_extern(cpp = "setSDA") setSda: (pin: UInt8) Bool
    pub @_mutates @_extern(cpp = "setSCL") setScl: (pin: UInt8) Bool
    pub @_mutates @_extern(cpp = "begin") begin: () Void
    pub @_mutates @_extern(cpp = "setClock") setClock: (hz: UInt32) Void
    pub @_mutates @_extern(cpp = "beginTransmission") beginTransmission: (address: UInt8) Void
    pub @_mutates @_extern(cpp = "endTransmission") endTransmission: (stop: Bool) UInt8
    pub @_mutates @_extern(cpp = "write") write: (b: UInt8) Size
    pub @_mutates @_extern(cpp = "requestFrom") requestFrom: (address: UInt8, count: Size, stop: Bool) Size
    pub @_mutates @_extern(cpp = "available") available: () Int32
    pub @_mutates @_extern(cpp = "read") read: () Int32
}

@_extern(cpp = "&Wire", header = "Wire.h") WIRE0: RawWire
@_extern(cpp = "&Wire1", header = "Wire.h") WIRE1: RawWire

// A transfer's outcome as Wire reports it: 0 is success.
pub I2C_OK: Int32 = 0

pub I2c: Mutable<Any> {
    raw: RawWire

    // Starts the bus as controller on the given pins at hz; false when the pins cannot be this bus's.
    pub begin: (sda: Int32, scl: Int32, hz: Int64) Bool {
        ok: Bool = raw.setSda(sda as UInt8) && raw.setScl(scl as UInt8)
        if ok {
            raw.begin()
            raw.setClock(hz as UInt32)
        }
        ok
    }

    // Whether a device answers at the 7-bit address.
    pub probe: (address: Int32) Bool {
        raw.beginTransmission(address as UInt8)
        raw.endTransmission(true) as Int32 == I2C_OK
    }

    // Writes bytes to the 7-bit address; the Wire status, 0 on success.
    pub writeBytes: (address: Int32, data: List<UInt8>) Int32 {
        raw.beginTransmission(address as UInt8)
        for i: Size in 0..data.size() {
            raw.write(data[i])
        }
        raw.endTransmission(true) as Int32
    }

    // Reads up to count bytes from the 7-bit address; the bytes that arrived.
    pub readBytes: (address: Int32, count: Int32) List<UInt8> {
        out: Mutable<List<UInt8>> { }
        raw.requestFrom(address as UInt8, count as Size, true)
        for i: Int32 in 0..count {
            if raw.available() > 0 {
                out.add(raw.read() as UInt8)
            }
        }
        out
    }
}

pub bus0: () I2c {
    I2c { WIRE0 }
}

pub bus1: () I2c {
    I2c { WIRE1 }
}
