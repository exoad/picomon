// A hardware UART: port0 is uart0 (Serial1), port1 is uart1 (Serial2). Its pins are GPIO numbers, set before begin.

@_opaque @_extern(cpp = "SerialUART", header = "Arduino.h") RawUart: Mutable<Any> {
    pub @_mutates @_extern(cpp = "setRX") setRx: (pin: UInt8) Bool
    pub @_mutates @_extern(cpp = "setTX") setTx: (pin: UInt8) Bool
    pub @_mutates @_extern(cpp = "begin") begin: (baud: UInt32) Void
    pub @_mutates @_extern(cpp = "end") end: () Void
    pub @_mutates @_extern(cpp = "write") write: (b: UInt8) Size
    pub @_mutates @_extern(cpp = "read") read: () Int32
    pub @_mutates @_extern(cpp = "available") available: () Int32
}

@_extern(cpp = "&Serial1", header = "Arduino.h") SERIAL1: RawUart
@_extern(cpp = "&Serial2", header = "Arduino.h") SERIAL2: RawUart

pub Uart: Mutable<Any> {
    raw: RawUart

    // Starts the port at baud, 8N1, on the given receive and transmit GPIOs; false when the pins cannot be this UART's.
    pub begin: (baud: Int64, rx: Int32, tx: Int32) Bool {
        ok: Bool = raw.setRx(rx as UInt8) && raw.setTx(tx as UInt8)
        if ok {
            raw.begin(baud as UInt32)
        }
        ok
    }

    pub end: () Void {
        raw.end()
    }

    pub write: (b: UInt8) Void {
        raw.write(b)
    }

    pub writeAll: (data: List<UInt8>) Void {
        for i: Size in 0..data.size() {
            raw.write(data[i])
        }
    }

    // The bytes waiting to be read.
    pub available: () Int32 {
        raw.available()
    }

    // The next byte, null when nothing is waiting.
    pub read: () Maybe<UInt8> {
        got: Int32 = raw.read()
        got < 0 ? null : got as UInt8
    }
}

pub port0: () Uart {
    Uart { SERIAL1 }
}

pub port1: () Uart {
    Uart { SERIAL2 }
}
