// Digital pins. A pin is its GPIO number. mode and write go through arduino-pico, which also reaches the Pico 2 W's
// LED on the wireless chip (LED_PIN); put and get are the SDK's plain GPIO calls.

@_extern(cpp = "PinMode", header = "Arduino.h") PinMode: Struct {
}

@_extern(cpp = "PinStatus", header = "Arduino.h") PinStatus: Struct {
}

pub @_extern(cpp = "INPUT", header = "Arduino.h") MODE_INPUT: PinMode
pub @_extern(cpp = "OUTPUT", header = "Arduino.h") MODE_OUTPUT: PinMode
pub @_extern(cpp = "INPUT_PULLUP", header = "Arduino.h") MODE_INPUT_PULLUP: PinMode
pub @_extern(cpp = "INPUT_PULLDOWN", header = "Arduino.h") MODE_INPUT_PULLDOWN: PinMode
@_extern(cpp = "HIGH", header = "Arduino.h") LEVEL_HIGH: PinStatus
@_extern(cpp = "LOW", header = "Arduino.h") LEVEL_LOW: PinStatus

// The onboard LED as arduino-pico numbers it: GP25, or the wireless chip's LED on a Pico 2 W.
pub @_extern(cpp = "PIN_LED", header = "Arduino.h") LED_PIN: UInt32

@_extern(cpp = "pinMode", header = "Arduino.h") rawMode: (pin: UInt8, mode: PinMode) Void
@_extern(cpp = "digitalWrite", header = "Arduino.h") rawWrite: (pin: UInt8, level: PinStatus) Void
@_extern(cpp = "gpio_put", header = "hardware/gpio.h") rawPut: (pin: UInt32, high: Bool) Void
@_extern(cpp = "gpio_get", header = "hardware/gpio.h") rawGet: (pin: UInt32) Bool

// Sets a pin to one of the MODE_ constants, which also gives it back to plain GPIO.
pub mode: (pin: Int32, kind: PinMode) Void {
    rawMode(pin as UInt8, kind)
}

pub write: (pin: Int32, high: Bool) Void {
    rawWrite(pin as UInt8, high ? LEVEL_HIGH : LEVEL_LOW)
}

// Sets a GPIO through the SDK, without the LED routing write has.
pub put: (pin: Int32, high: Bool) Void {
    rawPut(pin as UInt32, high)
}

pub get: (pin: Int32) Bool {
    rawGet(pin as UInt32)
}
