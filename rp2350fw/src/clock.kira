// Microseconds since boot, and sleeping.

@_extern(cpp = "time_us_64", header = "hardware/timer.h") rawMicros: () UInt64
@_extern(cpp = "sleep_ms", header = "pico/time.h") rawSleepMs: (ms: UInt32) Void

pub micros: () Int64 {
    rawMicros() as Int64
}

pub sleepMs: (ms: Int32) Void {
    rawSleepMs(ms as UInt32)
}

@_extern(cpp = "clock_handle_t", header = "hardware/clocks.h") ClockHandle: Struct {
}

@_extern(cpp = "clk_sys", header = "hardware/clocks.h") CLK_SYS: ClockHandle
@_extern(cpp = "clock_get_hz", header = "hardware/clocks.h") rawClockHz: (clock: ClockHandle) UInt32

// The system clock in hertz, which PWM slices count.
pub sysHz: () Int64 {
    rawClockHz(CLK_SYS) as Int64
}
