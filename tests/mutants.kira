KIRA: Str = "..\\vendor\\kira\\build\\install\\kira\\bin\\kira.bat"
KIRA_ROOT: Str = "vendor\\kira\\build\\install\\kira\\bin\\kira.bat"
PY: Str = ".venv\\Scripts\\python.exe"
PIO: Str = ".venv\\Scripts\\python.exe -m platformio"

// kind "host": the library's py tests must fail on the mutant. kind "drift": the pico2 firmware build must fail, because
// a binding no longer matches the SDK header it names.
pub Mutant: Any {
    pub file: Str
    pub old: Str
    pub new: Str
    pub kind: Str
    pub why: Str
}

MUTANTS: List<Mutant> = @listOf(
    Mutant { "rp2350/src/pin.kira", "pin >= 0 && pin < GPIO_COUNT", "pin >= 0 && pin <= GPIO_COUNT", "host", "validPin accepts GP30" },
    Mutant { "rp2350/src/pin.kira", "validPin(pin) && pin >= ADC_FIRST_PIN", "pin >= ADC_FIRST_PIN", "host", "adcInput is given to a non-pin" },
    Mutant { "rp2350/src/pin.kira", "? pin - ADC_FIRST_PIN : null", "? pin - ADC_FIRST_PIN + 1 : null", "host", "ADC0 is numbered 1" },
    Mutant { "rp2350/src/adc.kira", "raw >= 0 && raw <= ADC_MAX", "raw >= 0 && raw < ADC_MAX", "host", "full scale is refused" },
    Mutant { "rp2350/src/adc.kira", "vrefMv > 0", "vrefMv >= 0", "host", "a zero reference is accepted" },
    Mutant { "rp2350/src/adc.kira", "raw * vrefMv / ADC_MAX", "raw * vrefMv / (ADC_MAX + 1)", "host", "millivolts divides by the wrong count" },
    Mutant { "rp2350/src/pwm.kira", "percent <= 100", "percent < 100", "host", "100 percent is refused" },
    Mutant { "rp2350/src/pwm.kira", "wrap >= 1", "wrap >= 0", "host", "a wrap of 0 is accepted" },
    Mutant { "rp2350/src/pwm.kira", "wrap <= WRAP_MAX", "wrap < WRAP_MAX", "host", "the widest wrap is refused" },
    Mutant { "rp2350/src/pwm.kira", "wrap * percent / 100", "wrap * percent / 101", "host", "the level divides by the wrong percent" },
    Mutant { "rp2350/src/i2c.kira", "address >= FIRST_DEVICE_ADDRESS", "address >= 0", "host", "a reserved low address is accepted" },
    Mutant { "rp2350/src/i2c.kira", "address <= LAST_DEVICE_ADDRESS", "address < LAST_DEVICE_ADDRESS", "host", "the last device address is refused" },
    Mutant { "rp2350/src/timing.kira", "} else if nowUs >= nextUs {", "} else if nowUs > nextUs {", "host", "a ticker is due one microsecond late" },
    Mutant { "rp2350/src/timing.kira", "if !armed {", "if armed {", "host", "the first call fires" },
    Mutant { "rp2350/src/board.kira", "b.ledPin >= 0 ? LED_GPIO", "b.ledPin > 0 ? LED_GPIO", "host", "GPIO 0 is not an LED pin" },
    Mutant { "rp2350/src/board.kira", "b.wireless ? LED_WIRELESS", "!b.wireless ? LED_WIRELESS", "host", "the wireless and GPIO routes are swapped" },
    Mutant { "rp2350/src/board.kira", "index < PROFILES.size() as Int32", "index <= PROFILES.size() as Int32", "host", "an index past the table is read" },
    Mutant { "rp2350/src/board.kira", "index >= 0 && index", "index >= -1 && index", "host", "a negative index is read" },
    Mutant { "rp2350/src/board.kira", "\"\", -1, false, 0 }", "\"\", 0, false, 0 }", "host", "the none board has an LED on GP0" },
    Mutant { "rp2350/src/board.kira", "profileAt(index).unwrapOr(NO_BOARD)", "profileAt(index).unwrapOr(PROFILES[0])", "host", "a missing index falls back to the Pico 2" },
    Mutant { "rp2350fw/src/clock.kira", "rawMicros: () UInt64", "rawMicros: () Int64", "drift", "time_us_64 is bound as signed" },
    Mutant { "rp2350fw/src/adc.kira", "rawRead: () UInt16", "rawRead: () UInt32", "drift", "adc_read is bound as 32 bits" },
    Mutant { "rp2350fw/src/gpio.kira", "gpio_set_dir\", header", "gpio_set_direction\", header", "drift", "gpio_set_dir is renamed in the binding" },
    Mutant { "rp2350fw/src/pwm.kira", "rawSlice: (pin: UInt32) UInt32", "rawSlice: (pin: UInt32) Int32", "drift", "pwm_gpio_to_slice_num is bound as signed" },
    Mutant { "rp2350fw/include/rp2350/shim.hxx", "inline std::uint32_t uartBegin", "inline std::int32_t uartBegin", "drift", "the shim's uartBegin returns a signed value" },
    Mutant { "rp2350fw/include/rp2350/shim.hxx", "inline std::uint8_t uartGetByte", "inline std::uint16_t uartGetByte", "drift", "the shim's uartGetByte returns 16 bits" }
)

runProgram: (argv: List<Str>) Int32 {
    p: Maybe<Process> = spawnProcess(argv)
    p.isNull() ? 127 : p.value.wait()
}

runQuiet: (line: Str) Int32 {
    runProgram(@listOf("cmd", "/c", "${line} > %TEMP%\\rp2350-mutant-run.txt 2>&1"))
}

// Compiles the tests (and so the library's py) from tests/, then runs them.
checkHost: () Str {
    runQuiet("cd /d tests && ${KIRA} --target py") != 0 ? "not viable" : runQuiet("${PY} tests\\rp2350_test_kira.py") != 0 ? "killed" : "passes"
}

// Regenerates the firmware from the root, then builds pico2 against the SDK headers.
checkDrift: () Str {
    runQuiet("${KIRA_ROOT} --target cpp") != 0 ? "not viable" : runQuiet("${PIO} run -e pico2") != 0 ? "killed" : "passes"
}

checkOf: (kind: Str) Str {
    kind == "drift" ? checkDrift() : checkHost()
}

pub main: () Int32 {
    all: List<Str> = args()
    filt: Str = all.size() > 1 ? all[1] : ""
    baseline: Str = checkHost()
    if baseline != "passes" {
        println("baseline does not pass; no mutant run")
        2
    } else {
        killed: Mutable<Int32> = 0
        notViable: Mutable<Int32> = 0
        stale: Mutable<Int32> = 0
        survived: Mutable<List<Str>> { }
        chosen: Mutable<Int32> = 0
        for m: Mutant in MUTANTS {
            if m.file.contains(filt) {
                chosen += 1
                original: Str = readText(m.file).unwrapOr("")
                if original.split(m.old).size() != 2 {
                    stale += 1
                    println("STALE      ${m.file}: ${m.why}")
                } else {
                    writeFile(m.file, original.replace(m.old, m.new).bytes())
                    result: Str = checkOf(m.kind)
                    writeFile(m.file, original.bytes())
                    if result == "killed" {
                        killed += 1
                    } else if result == "not viable" {
                        notViable += 1
                        println("NOT VIABLE ${m.file}: ${m.why}")
                    } else {
                        survived.add("${m.file}: ${m.why}")
                    }
                }
            }
        }
        checkHost()
        runQuiet("${KIRA_ROOT} --target cpp")
        println("killed ${killed}, survived ${survived.size()}, not viable ${notViable}, stale ${stale}, of ${chosen}")
        for s: Str in survived {
            println("SURVIVED   ${s}")
        }
        survived.size() == 0 && stale == 0 ? 0 : 1
    }
}
