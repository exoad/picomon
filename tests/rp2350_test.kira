kira.test as test
rp2350.pin.validPin as validPin
rp2350.pin.adcInput as adcInput
rp2350.adc.millivolts as millivolts
rp2350.adc.ADC_MAX as ADC_MAX
rp2350.pwm.levelFor as levelFor
rp2350.i2c.validAddress as validAddress
rp2350.timing.Ticker as Ticker
rp2350.board.Board as Board
rp2350.board.PROFILES as PROFILES
rp2350.board.profileAt as profileAt
rp2350.board.boardAt as boardAt
rp2350.board.ledRoute as ledRoute
rp2350.board.NO_BOARD as NO_BOARD
rp2350.board.LED_NONE as LED_NONE
rp2350.board.LED_GPIO as LED_GPIO
rp2350.board.LED_WIRELESS as LED_WIRELESS
rp2350.slice.SlicePlan as SlicePlan
rp2350.slice.planFor as planFor
rp2350.slice.levelForPulse as levelForPulse

// rp2350_test: the library's pin, ADC, PWM, I2C, timing, board-profile and PWM-slice rules.

SYS_HZ: Int64 = 150000000

planOf: (sysHz: Int64, hz: Int64) SlicePlan {
    planFor(sysHz, hz).unwrapOr(SlicePlan { 0, 0 })
}

pinsAreTheBoardsGpios: (t: Suite) Void {
    t.check(validPin(0) && validPin(29), "GP0 and GP29 are pins")
    t.check(!validPin(30) && !validPin(-1), "GP30 and below zero are not")
    t.check(adcInput(26).unwrapOr(-1) == 0, "GP26 is ADC0")
    t.check(adcInput(29).unwrapOr(-1) == 3, "GP29 is ADC3")
    t.check(adcInput(25).isNull(), "GP25 has no ADC input")
    t.check(adcInput(30).isNull(), "a non-pin has no ADC input")
}

adcCountsBecomeMillivolts: (t: Suite) Void {
    t.check(millivolts(0, 3300).unwrapOr(-1) == 0, "zero counts are zero volts")
    t.check(millivolts(ADC_MAX, 3300).unwrapOr(-1) == 3300, "full scale is the reference")
    t.check(millivolts(2048, 3300).unwrapOr(-1) == 1650, "half scale rounds down")
    t.check(millivolts(4096, 3300).isNull(), "a count past 12 bits is refused")
    t.check(millivolts(-1, 3300).isNull(), "a negative count is refused")
    t.check(millivolts(100, 0).isNull(), "a reference of zero is refused")
}

pwmLevelIsAPercentOfTheWrap: (t: Suite) Void {
    t.check(levelFor(0, 1000).unwrapOr(-1) == 0, "0 percent is level 0")
    t.check(levelFor(100, 1000).unwrapOr(-1) == 1000, "100 percent is the wrap")
    t.check(levelFor(50, 999).unwrapOr(-1) == 499, "50 percent rounds down")
    t.check(levelFor(101, 1000).isNull(), "more than 100 percent is refused")
    t.check(levelFor(-1, 1000).isNull(), "less than 0 percent is refused")
    t.check(levelFor(50, 0).isNull(), "a wrap of 0 is refused")
    t.check(levelFor(50, 65535).unwrapOr(-1) == 32767, "the widest wrap is allowed")
    t.check(levelFor(50, 65536).isNull(), "a wrap past 16 bits is refused")
}

deviceAddressesAreTheNonReservedRange: (t: Suite) Void {
    t.check(!validAddress(0x07), "0x07 is reserved")
    t.check(validAddress(0x08), "0x08 is the first device address")
    t.check(validAddress(0x77), "0x77 is the last device address")
    t.check(!validAddress(0x78), "0x78 is reserved")
}

aTickerFiresOncePerPeriod: (t: Suite) Void {
    tick: Ticker { 1000 }
    t.check(!tick.due(0), "the first call only starts the count")
    t.check(!tick.due(999), "before the period is not due")
    t.check(tick.due(1000), "at the period it is due")
    t.check(!tick.due(1500), "half a period later it is not")
    t.check(tick.due(2000), "and due again one period on")
}

theProfilesAreTheBoards: (t: Suite) Void {
    t.check(PROFILES.size() == 3, "three board profiles")
    t.checkStr(boardAt(0).name, "pico2", "profile 0 is the Pico 2")
    t.checkStr(boardAt(1).name, "pico2_w", "profile 1 is the Pico 2 W")
    t.checkStr(boardAt(2).name, "beetle", "profile 2 is the Beetle")
    t.check(profileAt(3).isNull(), "an index past the table has no profile")
    t.check(profileAt(-1).isNull(), "a negative index has no profile")
    t.check(boardAt(2).flashBytes == 2097152, "the Beetle has 2 MB of flash")
    t.check(boardAt(0).flashBytes == 4194304, "the Pico 2 has 4 MB of flash")
}

aBoardsLedIsDrivenTheRightWay: (t: Suite) Void {
    t.check(ledRoute(boardAt(0)) == LED_GPIO, "the Pico 2 lights GP25")
    t.check(boardAt(0).ledPin == 25, "the Pico 2 LED is GP25")
    t.check(ledRoute(boardAt(1)) == LED_WIRELESS, "the Pico 2 W lights its LED through the chip")
    t.check(boardAt(1).ledPin < 0, "a wireless board has no GPIO LED")
    t.check(ledRoute(boardAt(2)) == LED_GPIO, "the Beetle lights GP25")
    t.check(ledRoute(NO_BOARD) == LED_NONE, "a board with no LED is refused")
    t.check(ledRoute(Board { "gpio0", "x", 0, false, 1 }) == LED_GPIO, "a GPIO 0 LED is a GPIO LED")
}

anIndexWithNoProfileIsRefused: (t: Suite) Void {
    t.checkStr(boardAt(7).name, "none", "a missing index gives the none board")
    t.check(ledRoute(boardAt(7)) == LED_NONE, "and that board is refused")
    t.checkStr(boardAt(1).name, "pico2_w", "a present index gives its board")
}

aServoSliceRunsAt50Hz: (t: Suite) Void {
    p: SlicePlan = planOf(SYS_HZ, 50)
    t.check(p.div16 == 733, "50 Hz takes the smallest divider that fits, 733 sixteenths")
    t.check(p.wrap == 65483, "and a wrap just under the 16-bit top")
    t.check(SYS_HZ * 16 / (p.div16 * (p.wrap + 1)) == 50, "which runs at 50 Hz")
    t.check(levelForPulse(p, 50, 1000).unwrapOr(-1) == 3274, "a 1000 us pulse")
    t.check(levelForPulse(p, 50, 1500).unwrapOr(-1) == 4911, "a 1500 us pulse")
    t.check(levelForPulse(p, 50, 2000).unwrapOr(-1) == 6548, "a 2000 us pulse")
    t.check(levelForPulse(p, 50, 20000).unwrapOr(-1) == 65484, "a pulse of the whole period is always on")
    t.check(levelForPulse(p, 50, 20001).isNull(), "a pulse longer than the period is refused")
    t.check(levelForPulse(p, 50, -1).isNull(), "a negative pulse is refused")
}

aFastSliceKeepsTheSmallestDivider: (t: Suite) Void {
    p: SlicePlan = planOf(SYS_HZ, 10000)
    t.check(p.div16 == 16, "10 kHz needs no division, a divider of 1")
    t.check(p.wrap == 14999, "and wraps at 14999")
    t.check(!planFor(SYS_HZ, 75000000).isNull(), "half the clock is the fastest, a wrap of 1")
    t.check(planFor(SYS_HZ, 75000001).isNull(), "faster than that is refused")
}

aSlowSliceStopsAtTheLargestDivider: (t: Suite) Void {
    t.check(planOf(16773120, 1).div16 == 4095, "the largest divider still fits")
    t.check(planFor(16777216, 1).isNull(), "one sixteenth past it is refused")
    t.check(planFor(SYS_HZ, 8).isNull(), "8 Hz is too slow for a 150 MHz clock")
    t.check(planFor(SYS_HZ, 0).isNull(), "0 Hz is refused")
}

pub main: () Int32 {
    t: Suite { title = "rp2350_test - the rp2350 library (pins, adc, pwm, i2c, timing, boards, slices)" }
    aServoSliceRunsAt50Hz(t)
    aFastSliceKeepsTheSmallestDivider(t)
    aSlowSliceStopsAtTheLargestDivider(t)
    pinsAreTheBoardsGpios(t)
    adcCountsBecomeMillivolts(t)
    pwmLevelIsAPercentOfTheWrap(t)
    deviceAddressesAreTheNonReservedRange(t)
    aTickerFiresOncePerPeriod(t)
    theProfilesAreTheBoards(t)
    aBoardsLedIsDrivenTheRightWay(t)
    anIndexWithNoProfileIsRefused(t)
    t.finish()
}
